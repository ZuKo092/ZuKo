# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE=your-service-role-jwt-here
SUPABASE_ANON_KEY=your-anon-key-jwt-here

# ── SMTP ─────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@yourdomain.de
SMTP_PASS=your-smtp-password
SMTP_SECURE=ssl

# ── Email defaults ───────────────────────────────────────
MAIL_FROM=info@yourdomain.de
MAIL_FROM_NAME=AnfrageBox
OWNER_EMAIL=info@yourdomain.de
BRAND_NAME=Your Company Name

# ── Company (default for standalone form) ────────────────
COMPANY_ID=your-company-uuid-here

# ── Cloudflare Turnstile ─────────────────────────────────
TURNSTILE_SECRET=your-turnstile-secret
TURNSTILE_SITEKEY=your-turnstile-sitekey

# ── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_or_sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# ── Cron tokens ──────────────────────────────────────────
CRON_TOKEN_FOLLOWUP=random-secure-token
CRON_TOKEN_PORTAL=random-secure-token
DEMO_CLEANUP_TOKEN=random-secure-token

# ── Admin tool ───────────────────────────────────────────
ADMIN_SECRET_TOKEN=random-secure-token

# ── CORS allowed origins (comma-separated) ───────────────
ALLOWED_ORIGINS=https://anfragebox.de,https://www.anfragebox.de
